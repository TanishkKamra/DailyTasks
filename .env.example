# Daily Tasks Environment Configuration Template
# Copy this file to '.env' and fill in your custom values if needed.

# Server Host & Port
HOST=0.0.0.0
PORT=5000

# Azure AI Foundry / Azure OpenAI credentials
# AZURE_AI_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
# AZURE_AI_API_KEY=your_azure_api_key_here
# AZURE_AI_MODEL=gpt-5-mini
# AZURE_AI_API_VERSION=2025-04-01-preview

# Alternative LLM Provider Keys
# GEMINI_API_KEY=your_google_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here

# Your brokerage email domains, comma-separated (never taken as the customer email)
# BROKER_EMAIL_DOMAINS=example-broker.com
